@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Sales Activities</h2>
        <p class="text-muted small mb-0">Track customer calls, meetings, emails, and daily sales tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="searchType" class="form-select">
                    <option value="">-- All Activity Types --</option>
                    @foreach (var t in (List<SelectListItem>)ViewBag.ActivityTypes)
                    {
                        <option value="@t.Value" selected="@(ViewBag.SearchType == t.Value ? "selected" : null)">@t.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="searchDate" value="@ViewBag.SearchDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <select name="searchStatus" class="form-select">
                    <option value="">-- All Statuses --</option>
                    @foreach (var s in (List<SelectListItem>)ViewBag.Statuses)
                    {
                        <option value="@s.Value" selected="@(ViewBag.SearchStatus == s.Value ? "selected" : null)">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="searchAssigned" class="form-select">
                    <option value="">-- All Reps --</option>
                    @foreach (var u in (List<SelectListItem>)ViewBag.SalesExecutives)
                    {
                        <option value="@u.Value" selected="@(ViewBag.SearchAssigned == u.Value ? "selected" : null)">@u.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Activity Table -->
<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Type</th>
                        <th>Subject</th>
                        <th>Date</th>
                        <th>Related Record</th>
                        <th>Representative</th>
                        <th>Status</th>
                        <th>Description</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border">
                                        @switch (item.ActivityType)
                                        {
                                            case "Call": <i class="bi bi-telephone-fill text-primary me-1"></i> break;
                                            case "Meeting": <i class="bi bi-people-fill text-success me-1"></i> break;
                                            case "Email": <i class="bi bi-envelope-fill text-info me-1"></i> break;
                                            case "Task": <i class="bi bi-check-square-fill text-warning me-1"></i> break;
                                        }
                                        @item.ActivityType
                                    </span>
                                </td>
                                <td class="fw-semibold">@item.Subject</td>
                                <td>@item.ActivityDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <small class="d-block text-primary"><i class="bi bi-person me-1"></i>@item.Customer.CustomerName</small>
                                    }
                                    @if (item.Lead != null)
                                    {
                                        <small class="d-block text-secondary"><i class="bi bi-funnel me-1"></i>@item.Lead.LeadName</small>
                                    }
                                    @if (item.Customer == null && item.Lead == null)
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(item.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Planned":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Planned</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Completed</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Cancelled</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-2 py-1">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td><small class="text-muted text-truncate d-inline-block" style="max-width: 180px;">@(item.Description ?? "-")</small></td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity record?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No activities recorded yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

