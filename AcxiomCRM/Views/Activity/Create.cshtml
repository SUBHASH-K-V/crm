@model AcxiomCRM.ViewModels.ActivityViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Log Sales Activity</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Activities</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-semibold">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" asp-items="ViewBag.ActivityTypes" class="form-select"></select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold">Activity Date <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" class="form-control" type="date" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject / Purpose <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="Introductory Discovery Call regarding Cloud migration" autofocus />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Related Customer</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                                <option value="">-- None / Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold">Related Lead</label>
                            <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                                <option value="">-- None / Select Lead --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold">Representative</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.SalesExecutives" class="form-select">
                                <option value="">-- Select Representative --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Activity Description / Meeting Minutes</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed notes, discussion points, next steps..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

