@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Opportunity Deals Report</h2>
        <p class="text-muted small mb-0">Stage velocity, probability metrics, and expected close forecasts</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer me-1"></i> Print / Export
    </button>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">-- All Stages --</option>
                    <option value="Qualification" selected="@(ViewBag.SelectedStage == "Qualification" ? "selected" : null)">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.SelectedStage == "Proposal" ? "selected" : null)">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.SelectedStage == "Negotiation" ? "selected" : null)">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.SelectedStage == "Won" ? "selected" : null)">Won</option>
                    <option value="Lost" selected="@(ViewBag.SelectedStage == "Lost" ? "selected" : null)">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Open" selected="@(ViewBag.SelectedStatus == "Open" ? "selected" : null)">Open</option>
                    <option value="Closed" selected="@(ViewBag.SelectedStatus == "Closed" ? "selected" : null)">Closed</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="ownerId" class="form-select">
                    <option value="">-- All Representatives --</option>
                    @foreach (var u in (List<SelectListItem>)ViewBag.Users)
                    {
                        <option value="@u.Value" selected="@(ViewBag.SelectedOwner == u.Value ? "selected" : null)">@u.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i> Filter</button>
                <a asp-action="OpportunityReport" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Opportunity Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Assigned Rep</th>
                        <th class="pe-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var o in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@o.OpportunityName</td>
                                <td>@(o.Customer?.CustomerName ?? "-")</td>
                                <td><span class="badge bg-light text-dark border">@o.Stage</span></td>
                                <td class="fw-bold text-dark">&#8377;@o.Amount.ToString("N0")</td>
                                <td>@o.Probability%</td>
                                <td class="fw-bold text-primary">&#8377;@o.WeightedValue.ToString("N0")</td>
                                <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="pe-3"><span class="badge @(o.Status == "Open" ? "bg-primary" : "bg-secondary")">@o.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">No opportunities found for the selected filter.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

