@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Customer Master Report</h2>
        <p class="text-muted small mb-0">Comprehensive exportable customer accounts and status summary</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer me-1"></i> Print / Export
    </button>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="CustomerReport" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Active" selected="@(ViewBag.SelectedStatus == "Active" ? "selected" : null)">Active</option>
                    <option value="Inactive" selected="@(ViewBag.SelectedStatus == "Inactive" ? "selected" : null)">Inactive</option>
                    <option value="Prospect" selected="@(ViewBag.SelectedStatus == "Prospect" ? "selected" : null)">Prospect</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="ownerId" class="form-select">
                    <option value="">-- All Account Owners --</option>
                    @foreach (var u in (List<SelectListItem>)ViewBag.Users)
                    {
                        <option value="@u.Value" selected="@(ViewBag.SelectedOwner == u.Value ? "selected" : null)">@u.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i> Generate Report</button>
                <a asp-action="CustomerReport" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City / State</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th class="pe-3">Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">@c.CustomerCode</td>
                                <td class="fw-semibold">@c.CustomerName</td>
                                <td>@(c.CompanyName ?? "-")</td>
                                <td>@c.Email</td>
                                <td>@c.Phone</td>
                                <td>@($"{c.City ?? "-"}, {c.State ?? "-"}")</td>
                                <td>@(c.Owner?.FullName ?? "Unassigned")</td>
                                <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                                <td class="pe-3">@c.CreatedDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">No records match the report criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

