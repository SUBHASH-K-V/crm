@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Sales Dashboard</h2>
        <p class="text-muted small mb-0">Welcome back, <strong>@ViewBag.UserName</strong></p>
    </div>
    <div>
        <span class="badge bg-primary px-3 py-2 fs-6">
            <i class="bi bi-shield-check me-1"></i> Role: @ViewBag.UserRole
        </span>
    </div>
</div>

<!-- KPI Cards Grid -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100 bg-white">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary me-3">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Total Customers</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalCustomers</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100 bg-white">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info me-3">
                    <i class="bi bi-funnel-fill fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Total Leads</h6>
                    <div class="d-flex align-items-baseline">
                        <h3 class="fw-bold mb-0 text-dark me-2">@Model.TotalLeads</h3>
                        <span class="badge bg-info text-dark small">@Model.OpenLeads Open</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100 bg-white">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning me-3">
                    <i class="bi bi-briefcase-fill fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Opportunities</h6>
                    <div class="d-flex align-items-baseline">
                        <h3 class="fw-bold mb-0 text-dark me-2">@Model.TotalOpportunities</h3>
                        <span class="badge bg-success small me-1">@Model.WonOpportunities Won</span>
                        <span class="badge bg-danger small">@Model.LostOpportunities Lost</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100 bg-white">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success me-3">
                    <i class="bi bi-currency-rupee fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Pipeline Value</h6>
                    <h3 class="fw-bold mb-0 text-success">&#8377;@Model.TotalPipelineValue.ToString("N0")</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary KPI Row (Follow-ups) -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body d-flex justify-content-between align-items-center p-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-clock-history text-primary fs-4 me-3"></i>
                    <div>
                        <h6 class="mb-0 fw-semibold">Pending Follow-Ups</h6>
                        <small class="text-muted">Activities scheduled for today and upcoming dates</small>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <span class="badge bg-primary fs-5 px-3 py-1 me-2">@Model.PendingFollowUps</span>
                    <a asp-controller="FollowUp" asp-action="Upcoming" class="btn btn-sm btn-outline-primary">View</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body d-flex justify-content-between align-items-center p-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-octagon text-danger fs-4 me-3"></i>
                    <div>
                        <h6 class="mb-0 fw-semibold text-danger">Overdue Follow-Ups</h6>
                        <small class="text-muted">Past activities requiring immediate attention</small>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <span class="badge bg-danger fs-5 px-3 py-1 me-2">@Model.OverdueFollowUps</span>
                    <a asp-controller="FollowUp" asp-action="Overdue" class="btn btn-sm btn-outline-danger">Review</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-3">
    <!-- Lead Status Doughnut Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart me-2 text-primary"></i>Lead Status Breakdown</h5>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Opportunity Pipeline Stage Bar Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Opportunities by Stage</h5>
            </div>
            <div class="card-body" style="min-height: 280px;">
                <canvas id="pipelineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Monthly Sales Trend Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Won Sales Outcome (&#8377;)</h5>
            </div>
            <div class="card-body" style="min-height: 280px;">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lead Status Chart
        const leadStatusCtx = document.getElementById('leadStatusChart').getContext('2d');
        const leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusData.Keys));
        const leadCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusData.Values));

        new Chart(leadStatusCtx, {
            type: 'doughnut',
            data: {
                labels: leadLabels.length ? leadLabels : ['No Leads'],
                datasets: [{
                    data: leadCounts.length ? leadCounts : [1],
                    backgroundColor: ['#3b82f6', '#06b6d4', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Opportunity Pipeline Chart
        const pipelineCtx = document.getElementById('pipelineChart').getContext('2d');
        const oppStages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipelineData.Keys));
        const oppCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipelineData.Values));

        new Chart(pipelineCtx, {
            type: 'bar',
            data: {
                labels: oppStages.length ? oppStages : ['Qualification', 'Proposal', 'Negotiation', 'Won', 'Lost'],
                datasets: [{
                    label: 'Opportunities',
                    data: oppCounts.length ? oppCounts : [0, 0, 0, 0, 0],
                    backgroundColor: '#6366f1',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                },
                plugins: { legend: { display: false } }
            }
        });

        // Monthly Sales Trend Chart
        const salesCtx = document.getElementById('salesTrendChart').getContext('2d');
        const salesMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData.Keys));
        const salesTotals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData.Values));

        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: salesMonths.length ? salesMonths : ['Current'],
                datasets: [{
                    label: 'Sales Revenue',
                    data: salesTotals.length ? salesTotals : [0],
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                },
                plugins: { legend: { display: false } }
            }
        });
    </script>
}

