@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-diagram-3-fill text-primary display-4"></i>
                    <h3 class="fw-bold mt-2">Sign in to AcxiomCRM</h3>
                    <p class="text-muted small">Enter your credentials to access your sales workspace</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@acxiomcrm.com" autofocus autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Remember me on this device</label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted small">Don't have an account? </span>
                        <a asp-action="Register" class="small fw-semibold text-decoration-none">Register here</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Demo Accounts Card -->
        <div class="card shadow-sm border-0 mt-4 bg-light">
            <div class="card-body p-3">
                <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-info-circle me-1"></i> Pre-Configured Test Accounts:</h6>
                <div class="small text-muted">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span><strong>Admin:</strong> admin@acxiomcrm.com</span>
                        <code>Admin@123</code>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span><strong>Manager:</strong> manager@acxiomcrm.com</span>
                        <code>Manager@123</code>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span><strong>Sales Exec:</strong> sales@acxiomcrm.com</span>
                        <code>Sales@123</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

