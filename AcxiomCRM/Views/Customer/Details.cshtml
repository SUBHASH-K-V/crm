@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">@Model.CustomerName</h2>
        <span class="badge bg-secondary me-2">@Model.CustomerCode</span>
        @if (Model.Status == "Active")
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-secondary">@Model.Status</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Customer Info Card -->
        <div class="card shadow-sm border-0 mb-4 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Contact Details</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email:</span>
                        <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">@Model.Email</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold">@Model.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Company:</span>
                        <span class="fw-semibold">@(Model.CompanyName ?? "-")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Account Owner:</span>
                        <span class="fw-semibold">@(Model.Owner?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created Date:</span>
                        <span>@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Address Card -->
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-geo-alt-fill me-2"></i>Address Information</h6>
            </div>
            <div class="card-body small">
                <p class="mb-1"><strong>Street:</strong> @(Model.Address ?? "-")</p>
                <p class="mb-1"><strong>City:</strong> @(Model.City ?? "-")</p>
                <p class="mb-0"><strong>State:</strong> @(Model.State ?? "-")</p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Notes Card -->
        <div class="card shadow-sm border-0 mb-4 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-card-text me-2"></i>Notes &amp; Background</h6>
            </div>
            <div class="card-body">
                <p class="text-muted mb-0">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded for this customer." : Model.Notes)</p>
            </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-lightning-charge-fill me-2"></i>Customer Actions</h6>
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a asp-controller="Opportunity" asp-action="Create" class="btn btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i> New Opportunity
                </a>
                <a asp-controller="FollowUp" asp-action="Create" class="btn btn-outline-info">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
                </a>
                <a asp-controller="Activity" asp-action="Create" class="btn btn-outline-success">
                    <i class="bi bi-telephone-plus me-1"></i> Log Activity
                </a>
            </div>
        </div>
    </div>
</div>

