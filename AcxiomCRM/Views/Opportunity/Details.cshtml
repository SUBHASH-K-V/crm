@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">@Model.OpportunityName</h2>
        <span class="badge bg-secondary me-2">Stage: @Model.Stage</span>
        @if (Model.Status == "Open")
        {
            <span class="badge bg-primary">Open Deal</span>
        }
        else
        {
            <span class="badge bg-dark">@Model.Status</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Opportunity
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Pipeline
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-cash-stack me-2"></i>Financial &amp; Deal Summary</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Total Deal Amount:</span>
                        <span class="fw-bold fs-6 text-dark">&#8377;@Model.Amount.ToString("N0")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Win Probability:</span>
                        <span class="fw-semibold">@Model.Probability%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Weighted Pipeline Value:</span>
                        <span class="fw-bold text-success fs-6">&#8377;@Model.WeightedValue.ToString("N0")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Related Customer:</span>
                        <span class="fw-semibold">@(Model.Customer?.CustomerName ?? "None")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Expected Close Date:</span>
                        <span class="fw-semibold">@Model.ExpectedCloseDate.ToString("dd MMMM yyyy")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assigned Sales Executive:</span>
                        <span class="fw-semibold">@(Model.AssignedUser?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created Date:</span>
                        <span>@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-card-text me-2"></i>Deal Strategy &amp; Notes</h6>
            </div>
            <div class="card-body">
                <p class="text-muted mb-0">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded for this opportunity." : Model.Notes)</p>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-lightning-charge me-2"></i>Opportunity Actions</h6>
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a asp-controller="FollowUp" asp-action="Create" class="btn btn-outline-primary">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
                </a>
                <a asp-controller="Activity" asp-action="Create" class="btn btn-outline-secondary">
                    <i class="bi bi-check2-circle me-1"></i> Log Meeting or Call
                </a>
            </div>
        </div>
    </div>
</div>

