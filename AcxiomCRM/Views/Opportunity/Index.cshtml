@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Sales Opportunities</h2>
        <p class="text-muted small mb-0">Track active deals, probability weighting, and pipeline revenue forecast</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-briefcase me-1"></i> New Opportunity
    </a>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search opportunity name..." />
            </div>
            <div class="col-md-3">
                <select name="searchCustomer" class="form-select">
                    <option value="">-- All Customers --</option>
                    @foreach (var c in (List<SelectListItem>)ViewBag.Customers)
                    {
                        <option value="@c.Value" selected="@(ViewBag.SearchCustomer?.ToString() == c.Value ? "selected" : null)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="searchStage" class="form-select">
                    <option value="">-- All Stages --</option>
                    @foreach (var s in (List<SelectListItem>)ViewBag.Stages)
                    {
                        <option value="@s.Value" selected="@(ViewBag.SearchStage == s.Value ? "selected" : null)">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="searchStatus" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Open" selected="@(ViewBag.SearchStatus == "Open" ? "selected" : null)">Open</option>
                    <option value="Closed" selected="@(ViewBag.SearchStatus == "Closed" ? "selected" : null)">Closed</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunity Table -->
<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Opportunity</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Deal Amount</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Close Date</th>
                        <th>Assigned To</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none text-dark">
                                        @item.OpportunityName
                                    </a>
                                </td>
                                <td>@(item.Customer?.CustomerName ?? "-")</td>
                                <td>
                                    @switch (item.Stage)
                                    {
                                        case "Qualification":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Qualification</span>
                                            break;
                                        case "Proposal":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Proposal</span>
                                            break;
                                        case "Negotiation":
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Negotiation</span>
                                            break;
                                        case "Won":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Won</span>
                                            break;
                                        case "Lost":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Lost</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-2 py-1">@item.Stage</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-bold text-dark">&#8377;@item.Amount.ToString("N0")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 6px; width: 60px;">
                                            <div class="progress-bar @(item.Probability >= 70 ? "bg-success" : item.Probability >= 40 ? "bg-warning" : "bg-danger")"
                                                 style="width: @item.Probability%"></div>
                                        </div>
                                        <small class="text-muted">@item.Probability%</small>
                                    </div>
                                </td>
                                <td class="fw-semibold text-primary">&#8377;@item.WeightedValue.ToString("N0")</td>
                                <td>
                                    @if (item.ExpectedCloseDate.Date < DateTime.Today && item.Status == "Open")
                                    {
                                        <span class="text-danger fw-semibold small" title="Overdue">
                                            <i class="bi bi-clock-history me-1"></i>@item.ExpectedCloseDate.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small">@item.ExpectedCloseDate.ToString("dd MMM yyyy")</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(item.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Mark opportunity @item.OpportunityName as closed?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Close">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No opportunities found in pipeline.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

