@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Leads</h2>
        <p class="text-muted small mb-0">Capture, track, qualify, and convert prospective sales leads</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-funnel me-1"></i> Capture New Lead
    </a>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search lead name..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchCompany" value="@ViewBag.SearchCompany" class="form-control" placeholder="Search company..." />
            </div>
            <div class="col-md-2">
                <select name="searchStatus" class="form-select">
                    <option value="">-- All Statuses --</option>
                    @foreach (var s in (List<SelectListItem>)ViewBag.Statuses)
                    {
                        <option value="@s.Value" selected="@(ViewBag.SearchStatus == s.Value ? "selected" : null)">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="searchAssigned" class="form-select">
                    <option value="">-- All Reps --</option>
                    @foreach (var u in (List<SelectListItem>)ViewBag.SalesExecutives)
                    {
                        <option value="@u.Value" selected="@(ViewBag.SearchAssigned == u.Value ? "selected" : null)">@u.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Lead Table -->
<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Value</th>
                        <th>Assigned To</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">@item.LeadCode</td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none text-dark">
                                        @item.LeadName
                                    </a>
                                </td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td>
                                    <small class="d-block">@item.Email</small>
                                    <small class="text-muted">@item.Phone</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "New":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">New</span>
                                            break;
                                        case "Contacted":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Contacted</span>
                                            break;
                                        case "Qualified":
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Qualified</span>
                                            break;
                                        case "Converted":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Converted</span>
                                            break;
                                        case "Lost":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Lost</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-semibold">&#8377;@item.ExpectedValue.ToString("N0")</td>
                                <td><small class="text-muted">@(item.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == "Qualified")
                                        {
                                            <form asp-action="Convert" asp-route-id="@item.LeadId" method="post" class="d-inline" onsubmit="return confirm('Convert lead @item.LeadName to a full customer account?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" title="Convert to Customer">
                                                    <i class="bi bi-arrow-right-circle me-1"></i> Convert
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.LeadId" method="post" class="d-inline" onsubmit="return confirm('Mark lead @item.LeadName as Lost?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Mark Lost">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No leads found matching the search criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

